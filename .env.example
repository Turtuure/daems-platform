APP_ENV=local
APP_URL=http://daems-platform.local
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daems_db
DB_USERNAME=root
DB_PASSWORD=

AUTH_TOKEN_TTL_DAYS=7
AUTH_TOKEN_HARD_CAP_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX_FAILS=5
AUTH_RATE_LIMIT_MAX_FAILS_PER_IP=20
AUTH_RATE_LIMIT_LOCKOUT_MIN=15

# === Communications module (0.8) ===
# 32-byte symmetric key for SMTP-DSN encryption (libsodium secretbox).
# Generate with: php -r 'echo base64_encode(sodium_crypto_secretbox_keygen());'
APP_ENCRYPTION_KEY=
